# Proyecto de Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
# Clave anon o publishable. Es pública: la protege RLS, no el secreto.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Único correo con acceso a la app. Solo de servidor: NUNCA con prefijo NEXT_PUBLIC_.
EMAIL_PERMITIDO=

# Servidor MCP (/api/mcp). Ambas solo de servidor: NUNCA con prefijo NEXT_PUBLIC_.
# Token que Claude manda en el encabezado "access-key", plano (también se acepta
# "Authorization: Bearer <token>"). Mínimo 32 caracteres;
# se genera con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MCP_TOKEN=
# Contraseña del usuario de EMAIL_PERMITIDO: el endpoint inicia sesión con ella
# para que RLS filtre por ese user_id. Si cambia en Supabase, se cambia aquí.
MCP_PASSWORD=

# Clave secreta de Supabase: salta RLS.
# solo local, para scripts; nunca en Vercel ni con prefijo NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
