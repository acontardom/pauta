# Proyecto de Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
# Clave anon o publishable. Es pública: la protege RLS, no el secreto.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Único correo con acceso a la app. Solo de servidor: NUNCA con prefijo NEXT_PUBLIC_.
EMAIL_PERMITIDO=

# Clave secreta de Supabase: salta RLS.
# solo local, para scripts; nunca en Vercel ni con prefijo NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
